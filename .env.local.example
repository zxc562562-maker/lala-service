# Supabase 프로젝트 > Connect > App Frameworks 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# 브라우저/세션용 publishable 키 (공개돼도 되는 키)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
# 서버 전용 secret 키 (절대 노출 금지 / NEXT_PUBLIC_ 붙이지 말 것)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxx

# 토스페이먼츠 (아래는 토스 공용 "테스트" 키 - 실결제는 본인 상점 키로 교체)
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6

# 웹 푸시(Web Push) — 아래 명령으로 키 쌍을 생성해 채워넣으세요:
#   npx web-push generate-vapid-keys
# PUBLIC 키는 브라우저에 노출되어도 되는 키, PRIVATE 키는 절대 노출 금지.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 예약 발송(크론) 보호용 시크릿 — Vercel Cron은 이 값을 Authorization: Bearer 헤더로 자동 전달합니다.
# (Vercel 외 다른 호스팅이면 외부 스케줄러에서 직접 이 헤더를 넣어 호출해야 합니다)
CRON_SECRET=

# 교차 앱 URL (로컬 기본값, 배포 시 각 Vercel 프로젝트 환경변수로 교체)
NEXT_PUBLIC_SERVICE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_DELIVERY_URL=http://localhost:3002
